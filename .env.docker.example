MYSQL_DATABASE=workstation
MYSQL_USER=workstation
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-another-strong-password

# 对外访问地址。生产环境必须使用 HTTPS 域名且不能带末尾斜杠。
WORKSTATION_PUBLIC_URL=http://localhost:8088
WORKSTATION_DEV_URL=http://localhost:5173

# Keycloak 管理账号仅用于管理身份中心，不是 Workstation 登录账号。
KEYCLOAK_ADMIN_USERNAME=keycloak-admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-strong-admin-password
# Keycloak 使用同一 MySQL 实例中的独立 keycloak 数据库和独立账号。
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=replace-with-a-strong-database-password
KEYCLOAK_CLIENT_SECRET=replace-with-at-least-32-random-characters
# Python Client Credentials 使用独立 Secret，不能与浏览器 Gateway Client 共用。
KEYCLOAK_PYTHON_CLIENT_SECRET=replace-with-a-different-strong-client-secret

# 首次导入 Realm 时创建的初始平台账号，首次登录需修改密码；普通用户通过公开注册创建独立账号。
WORKSTATION_INITIAL_USERNAME=owner
WORKSTATION_INITIAL_PASSWORD=replace-with-a-strong-temporary-password

# 邮件服务独立数据库、调用凭据与 Resend；注册和找回密码使用邮件验证码，在原认证页面输入。
MAIL_DB_USERNAME=workstation_mail
MAIL_DB_PASSWORD=replace-with-a-strong-mail-database-password
MAIL_KEYCLOAK_TOKEN=replace-with-a-random-keycloak-mail-token-at-least-32-characters
MAIL_BACKEND_TOKEN=replace-with-a-different-random-backend-mail-token-at-least-32-characters
# 替换为随机生成的 32 字节 Base64 密钥；更换前先处理待发任务。
MAIL_ENCRYPTION_KEY=replace-with-base64-encoded-32-random-bytes
RESEND_API_KEY=replace-with-a-domain-scoped-resend-api-key
MAIL_FROM=noreply@12718080.xyz
MAIL_FROM_NAME=Workstation
MAIL_REPLY_TO=
# 可选：Resend 控制台回调签名密钥；未配置时回调入口关闭，状态停留于供应商已接收。
RESEND_WEBHOOK_SECRET=

# Gateway Session 与 Backend 外部 API 共享限流存储。
REDIS_PASSWORD=replace-with-a-strong-redis-password

# RabbitMQ 只承载异步审计消息，管理页面仅绑定宿主机回环地址。
RABBITMQ_USERNAME=workstation
RABBITMQ_PASSWORD=replace-with-a-strong-rabbitmq-password

# XXL-JOB 使用独立数据库账号；调度中心页面仅绑定宿主机回环地址。
XXL_JOB_DB_USERNAME=xxl_job
XXL_JOB_DB_PASSWORD=replace-with-a-strong-xxl-job-database-password
XXL_JOB_ADMIN_PASSWORD=replace-with-a-strong-xxl-job-admin-password
XXL_JOB_ACCESS_TOKEN=replace-with-at-least-32-random-characters
XXL_JOB_SSO_TOKEN_KEY=replace-with-another-strong-random-key

APP_PORT=8088
TZ=Asia/Shanghai

# 外部数据源默认关闭；启用前配置随机生成的 32 字节 Base64 加密密钥。
INTEGRATIONS_ENABLED=false
INTEGRATIONS_KEY_VERSION=v1
INTEGRATIONS_ENCRYPTION_KEY=
INTEGRATIONS_PREVIOUS_ENCRYPTION_KEY=
INTEGRATIONS_ALLOWED_GITLAB_INSTANCES=https://gitlab.com
INTEGRATIONS_REQUEST_TIMEOUT_SECONDS=15
INTEGRATIONS_MAX_PAGES=500
INTEGRATIONS_MAX_ITEMS=300
INTEGRATIONS_LEASE_SECONDS=180
INTEGRATIONS_RECENT_DAYS=30
# 各 Backend 实例保持一致；同平台实例、同凭证共享额度。Redis 不可用时延期。
INTEGRATIONS_RATE_LIMIT_CAPACITY=5
INTEGRATIONS_RATE_LIMIT_REFILL_PER_SECOND=1
INTEGRATIONS_RATE_LIMIT_FALLBACK_COOLDOWN_SECONDS=60
INTEGRATIONS_RATE_LIMIT_REDIS_FAILURE_DELAY_SECONDS=30

DASHBOARD_RECENT_LIMIT=5
NOTE_IMPORT_MAX_FILE_BYTES=1048576

# GitHub 用户名或组织名，必须使用小写。
GHCR_NAMESPACE=max-xy-p

# 生产环境建议使用发布标签，例如 v1.0.0。
IMAGE_TAG=v1.0.0
