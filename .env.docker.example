MYSQL_DATABASE=workstation
MYSQL_USER=workstation
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-another-strong-password

APP_PORT=8088
TZ=Asia/Shanghai
DASHBOARD_RECENT_LIMIT=5
NOTE_IMPORT_MAX_FILE_BYTES=1048576

# GitHub 用户名或组织名，必须使用小写。
GHCR_NAMESPACE=max-xy-p

# 生产环境建议使用发布标签，例如 v1.0.0。
IMAGE_TAG=latest
