{
  "name": "@workstation/api-client",
  "version": "2.0.0",
  "description": "由 Workstation OpenAPI 契约生成的 TypeScript SDK",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "api:generate": "openapi-typescript ../../openapi/workstation.yaml -o src/generated/schema.ts",
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
