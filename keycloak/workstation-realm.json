{
  "realm": "workstation",
  "displayName": "Workstation",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "roles": {
    "realm": [
      {
        "name": "WORKSTATION_USER",
        "description": "允许用户进入 Workstation"
      },
      {
        "name": "WORKSTATION_ADMIN",
        "description": "Workstation 平台管理员，不自动获得工作空间内容权限"
      },
      {
        "name": "WORKSTATION_SERVICE",
        "description": "允许机器客户端进入 Workstation API"
      },
      {
        "name": "default-roles-workstation",
        "description": "新用户的普通准入与账号自助管理权限",
        "composite": true,
        "composites": {
          "realm": [
            "WORKSTATION_USER"
          ],
          "client": {
            "account": [
              "view-profile",
              "manage-account"
            ]
          }
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "workstation-gateway",
      "name": "Workstation Gateway",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_CLIENT_SECRET}",
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": [
        "${WORKSTATION_PUBLIC_URL}/login/oauth2/code/keycloak",
        "${WORKSTATION_DEV_URL}/login/oauth2/code/keycloak"
      ],
      "webOrigins": [
        "${WORKSTATION_PUBLIC_URL}",
        "${WORKSTATION_DEV_URL}"
      ],
      "attributes": {
        "post.logout.redirect.uris": "${WORKSTATION_PUBLIC_URL}/login?logout=success##${WORKSTATION_DEV_URL}/login?logout=success",
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "workstation-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "workstation-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "workstation-python",
      "name": "Workstation Python Client",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_PYTHON_CLIENT_SECRET}",
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "roles",
        "service_account"
      ],
      "protocolMappers": [
        {
          "name": "workstation-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "workstation-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "${WORKSTATION_INITIAL_USERNAME}",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "${WORKSTATION_INITIAL_PASSWORD}",
          "temporary": true
        }
      ],
      "realmRoles": [
        "WORKSTATION_USER",
        "WORKSTATION_ADMIN"
      ]
    },
    {
      "username": "service-account-workstation-python",
      "enabled": true,
      "serviceAccountClientId": "workstation-python",
      "realmRoles": [
        "WORKSTATION_SERVICE"
      ]
    }
  ],
  "verifyEmail": true,
  "actionTokenGeneratedByUserLifespan": 900,
  "smtpServer": {
    "from": "${MAIL_FROM}",
    "fromDisplayName": "${MAIL_FROM_NAME}"
  },
  "passwordPolicy": "length(12)",
  "defaultRole": {
    "name": "default-roles-workstation",
    "description": "新用户默认角色",
    "composite": true,
    "clientRole": false
  },
  "attributes": {
    "workstation.email-code.enabled": "true"
  },
  "accessCodeLifespanUserAction": 300
}
