# 数据库连接配置
SERVER_PORT=8080
DB_URL=jdbc:mysql://localhost:3306/workstation?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=
DB_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# Keycloak Resource Server 配置。
KEYCLOAK_ISSUER_URI=http://localhost:8088/auth/realms/workstation
KEYCLOAK_JWK_SET_URI=http://localhost:8090/auth/realms/workstation/protocol/openid-connect/certs
OAUTH2_AUDIENCE=workstation-api

# 应用配置

# 外部数据源默认关闭；启用前配置随机生成的 32 字节 Base64 加密密钥。
INTEGRATIONS_ENABLED=false
INTEGRATIONS_KEY_VERSION=v1
INTEGRATIONS_ENCRYPTION_KEY=
INTEGRATIONS_PREVIOUS_ENCRYPTION_KEY=
INTEGRATIONS_ALLOWED_GITLAB_INSTANCES=https://gitlab.com
INTEGRATIONS_REQUEST_TIMEOUT_SECONDS=15
INTEGRATIONS_MAX_PAGES=500
INTEGRATIONS_MAX_ITEMS=300
INTEGRATIONS_LEASE_SECONDS=180
INTEGRATIONS_RECENT_DAYS=30
# 各 Backend 实例保持一致；同平台实例、同凭证共享额度。Redis 不可用时延期。
INTEGRATIONS_RATE_LIMIT_CAPACITY=5
INTEGRATIONS_RATE_LIMIT_REFILL_PER_SECOND=1
INTEGRATIONS_RATE_LIMIT_FALLBACK_COOLDOWN_SECONDS=60
INTEGRATIONS_RATE_LIMIT_REDIS_FAILURE_DELAY_SECONDS=30

DASHBOARD_RECENT_LIMIT=5
NOTE_IMPORT_ALLOWED_ROOTS=D:/notes
NOTE_IMPORT_MAX_FILE_BYTES=1048576

# 本机源码调试时先启动 RabbitMQ 和 XXL-JOB；纯单元测试不需要启用。
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=workstation
RABBITMQ_PASSWORD=
RABBITMQ_LISTENER_AUTO_STARTUP=false
XXL_JOB_ENABLED=false
XXL_JOB_ADMIN_ADDRESSES=http://localhost:8089
XXL_JOB_ACCESS_TOKEN=
XXL_JOB_EXECUTOR_ADDRESS=http://host.docker.internal:9999
XXL_JOB_EXECUTOR_PORT=9999

# 外部 API 共享限流存储，与 Gateway 使用同一 Redis、独立 Key 前缀。
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-strong-redis-password
