# 数据库连接配置
SERVER_PORT=8080
DB_URL=jdbc:mysql://localhost:3306/workstation?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=
DB_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# Keycloak Resource Server 配置。
KEYCLOAK_ISSUER_URI=http://localhost:8088/auth/realms/workstation
KEYCLOAK_JWK_SET_URI=http://localhost:8090/auth/realms/workstation/protocol/openid-connect/certs
OAUTH2_AUDIENCE=workstation-api

# 应用配置
DASHBOARD_RECENT_LIMIT=5
NOTE_IMPORT_ALLOWED_ROOTS=D:/notes
NOTE_IMPORT_MAX_FILE_BYTES=1048576

# 本机源码调试时先启动 RabbitMQ 和 XXL-JOB；纯单元测试不需要启用。
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=workstation
RABBITMQ_PASSWORD=
RABBITMQ_LISTENER_AUTO_STARTUP=false
XXL_JOB_ENABLED=false
XXL_JOB_ADMIN_ADDRESSES=http://localhost:8089
XXL_JOB_ACCESS_TOKEN=
XXL_JOB_EXECUTOR_ADDRESS=http://host.docker.internal:9999
XXL_JOB_EXECUTOR_PORT=9999
